# https://vercel.com/docs/storage/vercel-postgres
POSTGRES_URL=

# Vercel Blob storage base URL (no trailing slash)
# Dev:  https://u2bzwczvuriijmfq.public.blob.vercel-storage.com
# Prod: https://xfibhacarkg58q0o.public.blob.vercel-storage.com
NEXT_PUBLIC_BLOB_BASE_URL=

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET= # Generate with: openssl rand -base64 32
AUTH_SECRET= # https://generate-secret.vercel.app/32

# Transactional email notifications
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NEXT_PUBLIC_BASE_URL=

# GitHub OAuth - https://authjs.dev/getting-started/providers/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth - https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Merchant Center - https://merchants.google.com/
# Service account JSON (stringified) with Content API access
GOOGLE_MERCHANT_SERVICE_ACCOUNT_JSON=
# Your Merchant Center account ID (numeric)
GOOGLE_MERCHANT_ID=
# API data source ID for product inputs (Merchant Center > Data sources > Add > API)
GOOGLE_MERCHANT_DATASOURCE_ID=
# Your storefront public URL (used to build product links)
STOREFRONT_BASE_URL=

# Inventory stock thresholds
NEXT_PUBLIC_LOW_STOCK_THRESHOLD=
NEXT_PUBLIC_CRITICAL_STOCK_THRESHOLD=

# BoardGameGeek XML API2 Bearer token
BGG_TOKEN=